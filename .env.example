# ── SAP 접속 정보 ──────────────────────────────────────
SAP_BASE=https://your-sap-host:44360
SAP_USER=your_sap_user
SAP_PASS=your_sap_password

# OData4 서비스 경로 (호스트 뒤, 끝 슬래시 없음)
SAP_SERVICE_PATH=/sap/opu/odata4/sap/zspaiv_r_tool_info_api_v4/srvd_a2x/sap/zspaiv_r_tool_info_api/0001
SAP_ENTITY=Tool
SAP_ACTION_NAMESPACE=com.sap.gateway.srvd_a2x.zspaiv_r_tool_info_api.v0001

# 사설 인증서면 false
SAP_VERIFY_SSL=false
SAP_TIMEOUT=120

# ── RAG 설정 ──────────────────────────────────────────
RAG_FETCH_FUNC=ZSPDEV_RAG_PRG_ANLZ
EMBED_MODEL=BAAI/bge-m3
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=sap_units
RAG_PAGE_LIMIT=300
